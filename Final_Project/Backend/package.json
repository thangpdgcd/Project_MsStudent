{
  "name": "coffee_project",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "nodemon src/server.js",
    "dev": "nodemon --exec babel-node src/server.js",
    "migrate": "sequelize db:migrate",
    "seed": "sequelize db:seed:all",
    "undo": "sequelize db:migrate:undo:all"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mysql2": "^3.5.2",
    "sequelize": "^6.37.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/node": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.1"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  }
}
